# Local design notes: never published. They come from earlier work and may
# name third parties; see the session bootstrap issue.
analyses/

# One worktree per branch lives here.
.worktrees/

# The private exclusion list of the documentation checks (docs/development.md,
# "Documentation checks"): its values must never be committed. Anchored and
# without a trailing slash, so that worktree.sh may link it into a worktree.
/.leak-patterns

# Secrets and local configuration.
.env
.env.*
!.env.example
*.pem
*.key

# Node.js
node_modules/
npm-debug.log*
.npm/

# Build and test output
dist/
build/
coverage/
.vitest/
.cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

