{
  "name": "@criticaloptimisation/vc-proofs",
  "version": "0.1.0",
  "description": "Holder binding and threshold proofs for verifiable credentials, as a browser library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CriticalOptimisation/vc-proofs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project chromium --project firefox --project webkit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@noble/curves": "2.4.0"
  }
}
